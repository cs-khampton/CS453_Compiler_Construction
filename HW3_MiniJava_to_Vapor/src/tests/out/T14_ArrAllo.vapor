func Main()
  t.0 = call :AllocArray(10)
  arr = t.0
  if arr goto :null1
    Error("null pointer")
  null1:
  t.1 = [arr]
  t.1 = Lt(3 t.1)
  if t.1 goto :bounds1
    Error("array index out of bounds")
  bounds1:
  t.1 = MulS(3 4)
  t.1 = Add(t.1 arr)
  [t.1+4] = 7
  if arr goto :null2
    Error("null pointer")
  null2:
  t.2 = [arr]
  t.2 = Lt(3 t.2)
  if t.2 goto :bounds2
    Error("array index out of bounds")
  bounds2:
  t.2 = MulS(3 4)
  t.2 = Add(t.2 arr)
  if arr goto :null3
    Error("null pointer")
  null3:
  t.3 = [arr]
  x = Add([t.2+4] t.3)
  PrintIntS(x)
  ret

func AllocArray(size)
  bytes = MulS(size 4)
  bytes = Add(bytes 4)
  v = HeapAllocZ(bytes)
  [v] = size
  ret v
