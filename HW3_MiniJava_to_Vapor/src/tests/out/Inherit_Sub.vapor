const vmt_Animal
  :Animal.speak

const vmt_Dog
  :Dog.speak

func Main()
  t.0 = HeapAllocZ(4)
  [t.0] = :vmt_Dog
  a = t.0
  if a goto :null1
    Error("null pointer")
  null1:
  t.1 = [a]
  t.1 = [t.1+0]
  t.2 = call t.1(a)
  PrintIntS(t.2)
  ret

func Animal.speak(this)
  ret 0

func Dog.speak(this)
  ret 1

