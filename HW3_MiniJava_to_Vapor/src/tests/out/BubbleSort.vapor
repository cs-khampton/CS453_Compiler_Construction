      t.9 = LtS(aux05 aux04)
      if0 t.9 goto :if2_else
        t.10 = Sub(j 1)
        aux06 = t.10
        t.11 = [this+4]
        t = int
        t.12 = [this+4]
        t.13 = [number]
        t.14 = LtS(aux06 t.13)
        if t.14 goto :bounds0_ok
          Error("array index out of bounds")
        bounds0_ok:
        t.15 = MulS(aux06 4)
        t.15 = Add(t.15 number)
        [t.15+4] = int
        t.16 = [number]
        t.17 = LtS(j t.16)
        if t.17 goto :bounds1_ok
          Error("array index out of bounds")
        bounds1_ok:
        t.18 = MulS(j 4)
        t.18 = Add(t.18 number)
        [t.18+4] = t
        goto :if2_end
      if2_end:
        nt = 0
      if2_end:
      t.19 = Add(j 1)
      j = t.19
      goto :while1_top
    while1_end:
    t.20 = Sub(i 1)
    i = t.20
    goto :while0_top
  while0_end:
  ret 0

func BBS.Print(this)
  j = 0
  while3_top:
    t.0 = [this+8]
    t.1 = LtS(j t.0)
    if0 t.1 goto :while3_end
    t.2 = [this+4]
    PrintIntS(int)
    t.3 = Add(j 1)
    j = t.3
    goto :while3_top
  while3_end:
  ret 0

