func BBS.Sort(this)
  t.0 = [this+8]
  t.1 = Sub(t.0 1)
  i = t.1
  t.2 = Sub(0 1)
  aux02 = t.2
  while0_top:
    t.3 = LtS(aux02 i)
    if0 t.3 goto :while0_end
    j = 1
    while1_top:
      t.4 = Add(i 1)
