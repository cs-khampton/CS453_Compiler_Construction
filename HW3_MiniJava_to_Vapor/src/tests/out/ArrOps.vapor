const vmt_Sorter
  :Sorter.getElement

func Main()
  t.0 = HeapAllocZ(4)
  [t.0] = :vmt_Sorter
  if t.0 goto :null1
    Error("null pointer")
  null1:
  t.1 = [t.0]
  t.1 = [t.1+0]
  t.2 = call t.1(t.0 3)
  PrintIntS(t.2)
  ret

func Sorter.getElement(this idx)
  t.0 = call :AllocArray(5)
  arr = t.0
  if arr goto :null2
    Error("null pointer")
  null2:
  t.1 = [arr]
  t.1 = Lt(0 t.1)
  if t.1 goto :bounds1
    Error("array index out of bounds")
  bounds1:
  t.1 = MulS(0 4)
  t.1 = Add(t.1 arr)
  [t.1+4] = 10
  if arr goto :null3
    Error("null pointer")
  null3:
  t.2 = [arr]
  t.2 = Lt(1 t.2)
  if t.2 goto :bounds2
    Error("array index out of bounds")
  bounds2:
  t.2 = MulS(1 4)
  t.2 = Add(t.2 arr)
  [t.2+4] = 20
  if arr goto :null4
    Error("null pointer")
  null4:
  t.3 = [arr]
  t.3 = Lt(idx t.3)
  if t.3 goto :bounds3
    Error("array index out of bounds")
  bounds3:
  t.3 = MulS(idx 4)
  t.3 = Add(t.3 arr)
  val = [t.3+4]
  result = Add(val idx)
  ret result

func AllocArray(size)
  bytes = MulS(size 4)
  bytes = Add(bytes 4)
  v = HeapAllocZ(bytes)
  [v] = size
  ret v
