const vmt_Count
  :Count.getDoubleVal
  :Count.doubled


func Main()
  t.0 = HeapAllocZ(8)
  [t.0] = :vmt_Count
  if t.0 goto :null1
    Error("null pointer")
  null1:
  t.1 = [t.0]
  t.1 = [t.1+0]
  t.2 = call t.1(t.0)
  PrintIntS(t.2)
  ret

func Count.getDoubleVal(this)
  [this+4] = 5
  t.0 = [this]
  t.0 = [t.0+4]
  t.1 = call t.0(this)
  ret t.1

func Count.doubled(this)
  t.0 = [this+4]
  ret MulS(t.0 2)

