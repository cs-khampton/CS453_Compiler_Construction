// Subtype check

class Subtype {
    public static void main(String[] args) {
        A a;
        A a2;
        B b;

        a2 = a.get(b); // no TE! B extends A so it should be valid. 

        System.out.println(1);
    }
}

class A {
    int first;

    public A get(A another) {
        return another;
    }
}

class B extends A {
    boolean second;
}